  "license": "MIT",
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "peerjs": "^1.5.5",
    "publint": "^0.3.24",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "peerjs": "^1.3.2"
  },
  "dependencies": {
    "eventemitter3": "^5.0.4"
  },
  "publishConfig": {
    "access": "public"
  }
