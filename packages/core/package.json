      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./master": {
      "types": "./dist/master.d.ts",
      "import": "./dist/master.js"
    },
    "./remote": {
      "types": "./dist/remote.d.ts",
      "import": "./dist/remote.js"
    }
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch"
  },
