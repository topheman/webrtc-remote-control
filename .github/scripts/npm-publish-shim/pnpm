#!/usr/bin/env node

// `changeset publish` auto-detects this pnpm workspace and shells out to
// `pnpm publish` for the actual registry write. pnpm 12's native publish
// implementation (its own Rust "pacquet" engine, not the npm CLI) gets a 403
// "OIDC permission denied for this action" from npmjs.com's trusted-publishing
// exchange, even with a verified-correct trusted publisher configuration and
// the same GitHub Actions OIDC token that a real `npm publish` accepts fine.
// See plan.local/pnpm-oidc-publish-workaround.md for the investigation.
//
// This file sits earlier on PATH than the real `pnpm` for the duration of the
// `release` script (see the root package.json "release" script) and
// intercepts only the `pnpm publish` call changesets/cli makes, redirecting
// the actual registry write to the real, OIDC-tested npm CLI. Every other
// pnpm subcommand (pack, info, --version, ...) is forwarded to the real pnpm
// untouched, so the rest of `changeset publish` behaves exactly as before -
// including its git tagging and GitHub release integration, which only look
// at the exit code and don't parse pnpm-specific publish output on success.

const { spawnSync } = require("node:child_process");

const args = process.argv.slice(2);

function run(command, commandArgs) {
  const result = spawnSync(command, commandArgs, {
    stdio: "inherit",
    env: process.env,
  });
  if (result.error) throw result.error;
  process.exit(result.status ?? 1);
}

if (args[0] !== "publish") {
  const realPnpm = process.env.WRTC_REAL_PNPM;
  if (!realPnpm) {
    console.error(
      "WRTC_REAL_PNPM is not set - this shim must only run with it exported to the real pnpm binary.",
    );
    process.exit(1);
  }
  run(realPnpm, args);
}

// changesets/cli's pnpm.publish() calls:
//   pnpm publish [--json] <tarballPath> --access <access> --tag <tag> --no-git-checks [--otp <otp>]
// `--no-git-checks` and `--json` are pnpm-only flags npm doesn't understand
// (and changesets never parses success-path stdout), so they're dropped;
// everything else npm publish accepts as-is.
const npmArgs = ["publish"];
for (const arg of args.slice(1)) {
  if (arg === "--no-git-checks" || arg === "--json") continue;
  npmArgs.push(arg);
}

run("npm", npmArgs);
