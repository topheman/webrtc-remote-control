{
  "name": "webrtc-remote-control",
  "version": "0.0.1",
  "description": "",
  "private": true,
  "main": "src/index.js",
  "scripts": {
    "prepare": "vp config --no-agent",
    "build": "vp run -r build",
    "build:core": "vp run @webrtc-remote-control/core#build",
    "build:react": "vp run @webrtc-remote-control/react#build",
    "build:vue": "vp run @webrtc-remote-control/vue#build",
    "build:demo": "vp run @webrtc-remote-control/demo#build",
    "build:peer-server": "VITE_USE_LOCAL_PEER_SERVER=true vp run -r build",
    "dev": "vp run -r --parallel dev",
    "dev:peer-server": "VITE_USE_LOCAL_PEER_SERVER=true start-server-and-test peer-server http-get://localhost:9000/myapp dev",
    "dev:core": "vp run @webrtc-remote-control/core#dev",
    "dev:react": "vp run @webrtc-remote-control/react#dev",
    "dev:vue": "vp run @webrtc-remote-control/vue#dev",
    "dev:demo": "vp run @webrtc-remote-control/demo#dev",
    "check": "vp check",
    "typecheck:vue": "vue-tsc --noEmit -p demo/tsconfig.vue.json",
    "lint": "vp lint",
    "format": "vp fmt",
    "peer-server": "peerjs --port 9000 --key peerjs --path /myapp",
    "preview": "vp preview",
    "preview:peer-server": "start-server-and-test peer-server http-get://localhost:9000/myapp preview",
    "test": "vp test run",
    "test:watch": "vp test",
    "test:precommit": "vp test related --run",
    "test:core": "vp test run --project core",
    "test:core:watch": "vp test --project core",
    "test:react": "vp test run --project react",
    "test:react:watch": "vp test --project react",
    "test:vue": "vp test run --project vue",
    "test:vue:watch": "vp test --project vue",
    "test:demo": "vp test run --project demo",
    "test:demo:watch": "vp test --project demo",
    "test:e2e": "VITE_USE_LOCAL_PEER_SERVER=true vp run e2e",
    "check:dotenv": "dotenv -c -- node -e 'console.log(process.env.FOO_BAR)'",
    "changeset": "changeset",
    "changeset:version": "VP_GIT_HOOKS=0 changeset version",
    "changeset:status": "changeset status",
    "release": "vp run -r build && VP_GIT_HOOKS=0 changeset publish",
    "clean:install": "find . -name \"node_modules\" -exec rm -rf '{}' +",
    "test:e2e:install": "vp run @webrtc-remote-control/demo#test:e2e:install",
    "test:e2e:ui": "vp run @webrtc-remote-control/demo#test:e2e:ui",
    "test:e2e:headed": "vp run @webrtc-remote-control/demo#test:e2e:headed",
    "test:e2e:report": "vp run @webrtc-remote-control/demo#test:e2e:report"
  },
  "keywords": [
    "webrtc",
    "remote"
  ],
  "author": "Christophe Rosset <tophe@topheman.com> (http://labs.topheman.com/)",
  "license": "MIT",
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^3.0.2",
    "@commitlint/cli": "^16.2.3",
    "@commitlint/config-conventional": "^16.2.1",
    "@vitejs/plugin-react": "catalog:",
    "expect-type": "1.4.0",
    "jsdom": "^30.0.1",
    "peer": "^0.6.1",
    "start-server-and-test": "catalog:",
    "typescript": "6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vue-tsc": "3.3.11"
  },
  "packageManager": "pnpm@12.4.1"
}
