{
  "name": "webrtc-remote-control",
  "version": "0.0.1",
  "description": "",
  "private": true,
  "main": "src/index.js",
  "scripts": {
    "build": "pnpm run build:core && pnpm run build:react && pnpm run build:vue && pnpm run build:demo",
    "build:core": "pnpm --filter @webrtc-remote-control/core run build",
    "build:react": "pnpm --filter @webrtc-remote-control/react run build",
    "build:vue": "pnpm --filter @webrtc-remote-control/vue run build",
    "build:demo": "pnpm --filter @webrtc-remote-control/demo run build",
    "build:peer-server": "VITE_USE_LOCAL_PEER_SERVER=true pnpm run build",
    "dev": "pnpm --parallel --filter \"@webrtc-remote-control/*\" run dev",
    "dev:peer-server": "VITE_USE_LOCAL_PEER_SERVER=true npm-run-all --parallel dev peer-server",
    "dev:forward": "npm-run-all --parallel dev demo:forward",
    "dev:core": "pnpm --filter @webrtc-remote-control/core run dev",
    "dev:react": "pnpm --filter @webrtc-remote-control/react run dev",
    "dev:vue": "pnpm --filter @webrtc-remote-control/vue run dev",
    "dev:demo": "pnpm --filter @webrtc-remote-control/demo run dev",
    "demo:forward": "pnpm --filter @webrtc-remote-control/demo run forward",
    "lint": "eslint --ext .js,.jsx .",
    "peer-server": "peerjs --port 9000 --key peerjs --path /myapp",
    "preview": "pnpm --filter @webrtc-remote-control/demo run preview",
    "preview:peer-server": "npm-run-all --parallel preview peer-server",
    "preview:forward": "npm-run-all --parallel preview demo:forward",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:precommit": "vitest related --run",
    "test:core": "vitest run --project core",
    "test:core:watch": "vitest --project core",
    "test:react": "vitest run --project react",
    "test:react:watch": "vitest --project react",
    "test:vue": "vitest run --project vue",
    "test:vue:watch": "vitest --project vue",
    "test:demo": "vitest run --project demo",
    "test:demo:watch": "vitest --project demo",
    "test:e2e": "pnpm --filter @webrtc-remote-control/demo run test:e2e",
    "test:e2e:watch": "pnpm --filter @webrtc-remote-control/demo run test:e2e:watch",
    "test:e2e:start-server-and-test": "pnpm --filter @webrtc-remote-control/demo run test:e2e:start-server-and-test",
    "test:e2e:start-server-and-test:peer-server": "npm-run-all --parallel --race peer-server test:e2e:start-server-and-test",
    "prepare": "husky install",
    "check:dotenv": "dotenv -c -- node -e 'console.log(process.env.FOO_BAR)'",
    "changeset": "changeset",
    "changeset:version": "HUSKY=0 changeset version",
    "changeset:status": "changeset status",
    "release": "pnpm run build && HUSKY=0 changeset publish",
    "clean:install": "find . -name \"node_modules\" -exec rm -rf '{}' +"
  },
  "keywords": [
    "webrtc",
    "remote"
  ],
  "author": "Christophe Rosset <tophe@topheman.com> (http://labs.topheman.com/)",
  "license": "MIT",
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^3.0.2",
    "@commitlint/cli": "^16.2.3",
    "@commitlint/config-conventional": "^16.2.1",
    "@vitejs/plugin-react": "catalog:",
    "eslint": "^8.6.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-import": "^2.25.4",
    "eslint-plugin-jsx-a11y": "^6.5.1",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-react": "^7.28.0",
    "eslint-plugin-react-hooks": "^4.3.0",
    "husky": "^7.0.4",
    "jsdom": "^30.0.1",
    "lint-staged": "^12.1.7",
    "npm-run-all": "^4.1.5",
    "peer": "^0.6.1",
    "prettier": "2.5.1",
    "vitest": "catalog:"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --cache --fix",
      "pnpm run test:precommit"
    ],
    "*.{css,html,ts,tsx,mts}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@12.4.1"
}
